package hande;

import org.junit.jupiter.api.Test;

import static org.junit.jupiter.api.Assertions.assertEquals;

/**
 * The worked example, as a test: fit y = x1 + x2*t to the points
 * (0,0), (1,1), (2,4) in the Chebyshev norm.
 *
 * Hand-derived ground truth (equioscillation with signs +,-,+):
 *   x* = (-1/2, 2),  residuals = (+1/2, -1/2, +1/2),  RESMAX = 1/2,
 *   3 pivots total (2 level-1 + 1 level-2 + 0 level-3), rank 2, unique.
 *
 * Part 1 pins down every cell of the INITIAL tableau (the CHE 690-890
 * transcription in ChebyshevTableau). Part 2 runs the full solver and pins
 * down the traced outcome.
 */
class ChebyshevWorkedExampleTest {

    // The system: x1 + 0*x2 = 0 ; x1 + 1*x2 = 1 ; x1 + 2*x2 = 4
    private static final double[][] A = {
            {1.0, 0.0},
            {1.0, 1.0},
            {1.0, 2.0}
    };
    private static final double[] B = {0.0, 1.0, 4.0};

    // ------------------------------------------------------------------
    // Part 1: the setup — every cell of the pre-pivot tableau
    // ------------------------------------------------------------------

    @Test
    void initialTableauMatchesHandConstruction() {
        ChebyshevTableau t = ChebyshevTableau.build(A, B);

        assertEquals(3, t.m);
        assertEquals(2, t.n);
        assertEquals(3, t.np1, "ones row index");
        assertEquals(4, t.np2, "objective row index");
        assertEquals(5, t.np3, "badge row index");
        assertEquals(4, t.mp1, "badge column index");

        double[][] a = t.a;

        // rows 1..n : A-transpose (row = unknown, column = equation)
        //   x1 row: coefficients of x1 in eq 1,2,3
        assertEquals(1.0, a[1][1]);
        assertEquals(1.0, a[1][2]);
        assertEquals(1.0, a[1][3]);
        //   x2 row: coefficients of x2 in eq 1,2,3  (these are the t-values)
        assertEquals(0.0, a[2][1]);
        assertEquals(1.0, a[2][2]);
        assertEquals(2.0, a[2][3]);

        // ones row (lambda), CHE 790
        assertEquals(1.0, a[3][1]);
        assertEquals(1.0, a[3][2]);
        assertEquals(1.0, a[3][3]);

        // objective row = -b, CHE 800
        assertEquals(-0.0, a[4][1]);
        assertEquals(-1.0, a[4][2]);
        assertEquals(-4.0, a[4][3]);

        // column badges = n + j = 3, 4, 5, CHE 810
        assertEquals(3.0, a[5][1]);
        assertEquals(4.0, a[5][2]);
        assertEquals(5.0, a[5][3]);

        // row badges = 1, 2 (CHE 880); ones row badge = 0 (CHE 830)
        assertEquals(1.0, a[1][4], "row 1 wears badge 1: 'I am x1'");
        assertEquals(2.0, a[2][4], "row 2 wears badge 2: 'I am x2'");
        assertEquals(0.0, a[3][4], "ones row wears badge 0: lambda");
    }

    // ------------------------------------------------------------------
    // Part 2: the pivots — end state must match the hand trace
    // ------------------------------------------------------------------

    @Test
    void solveReproducesTracedSolution() {
        ChebyshevSolver.Result r = ChebyshevSolver.solve(A, B, 1.0e-13, 0.0);

        // x* = (-1/2, 2): read from obj row via column badges 1 and 2
        assertEquals(-0.5, r.x()[0], 1.0e-12, "x1 (intercept)");
        assertEquals( 2.0, r.x()[1], 1.0e-12, "x2 (slope)");

        // RESMAX = the red cell a[np2][m] = 1/2
        assertEquals(0.5, r.resmax(), 1.0e-12);

        // residuals (+1/2, -1/2, +1/2): equioscillation, signs + - +
        assertEquals(+0.5, r.residuals()[0], 1.0e-12, "eq 1, point (0,0)");
        assertEquals(-0.5, r.residuals()[1], 1.0e-12, "eq 2, point (1,1)");
        assertEquals(+0.5, r.residuals()[2], 1.0e-12, "eq 3, point (2,4)");

        // 3 pivots: 2 level-1 (seat x2 then x1) + 1 level-2 (wake lambda),
        // level 3 vacuously optimal (rankp1 == m, no candidate columns)
        assertEquals(3, r.iter(), "pivot count from the trace");

        // full rank, and the optimum is unique (no degenerate zero in the
        // lambda column: final col-3 entries were 1/2, 1/4, 1/4)
        assertEquals(2, r.rank());
        assertEquals(1, r.ocode(), "unique optimal solution");
    }

    // ------------------------------------------------------------------
    // Bonus: the interpolation the algorithm passes through after Level 1
    // (line through points 2 and 3 only) is strictly worse in minimax terms
    // ------------------------------------------------------------------

    @Test
    void levelOneInterpolantIsWorseThanOptimum() {
        // After the two level-1 pivots the tableau's tentative solution was
        // x = (-2, 3): the line through (1,1) and (2,4), missing (0,0) by 2.
        double[] interpolant = {-2.0, 3.0};
        double worst = 0.0;
        for (int i = 0; i < B.length; i++) {
            double res = B[i] - (A[i][0] * interpolant[0] + A[i][1] * interpolant[1]);
            worst = Math.max(worst, Math.abs(res));
        }
        assertEquals(2.0, worst, 1.0e-12, "interpolant's worst miss");

        // the level-2 pivot cut that from 2 to 1/2
        ChebyshevSolver.Result r = ChebyshevSolver.solve(A, B, 1.0e-13, 0.0);
        assertEquals(0.5, r.resmax(), 1.0e-12,
                "one ones-row pivot: worst miss 2 -> 1/2");
    }
}
